{
  "name": "@blerb/petgen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "petgen": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build && tsc --noEmit -p preview/tsconfig.json",
    "petgen": "tsx src/cli.ts",
    "preview": "tsx src/cli.ts preview",
    "pokemon": "tsx scripts/import-vscode-pokemon.mts",
    "make-blob": "node scripts/make-blob-atlas.mjs"
  },
  "dependencies": {
    "@blerb/core": "workspace:*",
    "@blerb/pack": "workspace:*",
    "@blerb/render-canvas": "workspace:*",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vite": "^6.0.5"
  }
}
